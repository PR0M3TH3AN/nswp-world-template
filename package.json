{
  "name": "nswp-world-template",
  "version": "0.1.0",
  "private": true,
  "description": "A starting point for a world on the Nostr Spatial Web Protocol: a WebXR place of your own, with the protocol's plumbing already done.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && node scripts/build.mjs && node scripts/check.mjs",
    "check:live": "node vendor/nswp/nswp-cli.js check",
    "keygen": "node scripts/sign.mjs --keygen",
    "sign": "node scripts/sign.mjs",
    "announce": "node scripts/announce.mjs",
    "preview": "node scripts/preview.mjs",
    "doors": "node scripts/doors.mjs",
    "look": "node scripts/look.mjs",
    "update": "node scripts/update.mjs",
    "vendor": "node scripts/vendor.mjs",
    "vendor:check": "node scripts/vendor.mjs --check"
  },
  "devDependencies": {
    "@types/three": "^0.187.0",
    "@types/webxr": "^0.5.24",
    "esbuild": "^0.28.2",
    "iwer": "^2.8.0",
    "three": "^0.187.0",
    "typescript": "^7.0.2"
  },
  "optionalDependencies": {
    "playwright-core": "^1.65.1"
  }
}
