{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["webxr"],
    "strict": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "paths": {
      "@nswp/core": ["./vendor/nswp/types/index.d.ts"],
      "nswp-sdk": ["./vendor/nswp/sdk-types/index.d.ts"],
      "nswp-sdk/three": ["./vendor/nswp/sdk-types/three.d.ts"],
      "nswp-sdk/home": ["./vendor/nswp/sdk-types/home.d.ts"],
      "nswp-sdk/ui": ["./vendor/nswp/sdk-types/ui.d.ts"],
      "nswp-sdk/terminal": ["./vendor/nswp/sdk-types/terminal.d.ts"]
    }
  },
  "include": ["src"]
}
